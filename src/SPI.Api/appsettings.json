{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/spi-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "SPI.Api",
    "Audience": "SPI.Clientes",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Smtp": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPorta": 587,
    "RemetenteNome": "SPI - Sistema para Professoras Independentes"
  },
  "Lembretes": {
    "IntervaloVerificacaoSegundos": 60,
    "MaxEmailsPorCiclo": 10
  },
  "Mensalidade": {
    "IntervaloVerificacaoSegundos": 3600
  },
  "Notificacoes": {
    "AulasPendentesDesde": "2026-10-19T00:00:00",
    "IntervaloVerificacaoSegundos": 300,
    "AulaFuturaDiasAntes": 1,
    "AulaFuturaHora": "08:00"
  },
  "Turmas": {
    "IntervaloEncerramentoMinutos": 60
  },
  "LembretePagamento": {
    "IntervaloVerificacaoSegundos": 300
  },
  "MensalidadeLembrete": {
    "IntervaloVerificacaoSegundos": 3600,
    "AntecedenciaDias": 5
  },
  "AllowedHosts": "*"
}
